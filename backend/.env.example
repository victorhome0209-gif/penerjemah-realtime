# Salin menjadi .env untuk uji lokal, atau isi sebagai Variables/Secrets di hosting backend.
# JANGAN pernah men-commit file .env. File ini hanya berisi placeholder, bukan nilai asli.

# --- Rahasia (isi hanya di server) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Token admin untuk membuat kode akses tester. Isi teks acak minimal 24 karakter.
ADMIN_TOKEN=

# --- Akses ---
# Alamat web yang boleh memanggil backend (pisahkan dengan koma). Tanpa garis miring di akhir.
ALLOWED_ORIGINS=https://victorhome0209-gif.github.io
# Isi true bila server berada di belakang proxy hosting (Railway, Fly.io) agar IP klien terbaca benar.
TRUST_PROXY=true

# --- Pengaman biaya ---
# Panggilan berbayar MATI sampai ini diubah menjadi true. Ubah hanya setelah Anda siap menguji.
PAID_API_ENABLED=false
# Batas INTERNAL berbasis PERKIRAAN (bukan tagihan) per bulan dalam USD. Layanan berhenti otomatis bila terlampaui.
# Ini BUKAN pengganti HARD spend limit di project OpenAI (yang mengikat dan harus Anda atur sendiri).
# Spend alert OpenAI hanya notifikasi, bukan batas. Saran: isi tidak lebih dari separuh hard limit.
MONTHLY_BUDGET_USD=5
# Batas saldo total per kode, dan kredit maksimum per operasi admin.
MAX_BALANCE=10000000
ADMIN_MAX_CREDITS_PER_OP=1000000
# false (bawaan): galat 5xx dari OpenAI dianggap status BELUM PASTI (UNKNOWN), kredit ditahan sampai admin memeriksa.
# true: 5xx dianggap pasti gagal dan dikembalikan otomatis (lebih nyaman, tetapi bisa merugikan bila OpenAI sempat menagih).
REFUND_ON_PROVIDER_5XX=false
DAILY_CALLS_PER_CODE=600
RATE_PER_MIN=90

# --- Provider (hanya OpenAI aktif di V1) ---
STT_PROVIDER=openai
TRANSLATION_PROVIDER=openai
TTS_PROVIDER=openai
ENABLE_ANTHROPIC=false
ENABLE_ELEVENLABS=false

# --- Model OpenAI (diperiksa terhadap dokumentasi 29 Okt 2026; verifikasi ulang sebelum uji nyata) ---
# gpt-4o-mini-tts DEPRECATED, berhenti 2027-01-06 (pengganti memakai Realtime API). Server memberi peringatan saat start.
OPENAI_MODEL_STT=gpt-transcribe
OPENAI_MODEL_TRANSLATE=gpt-6-luna
OPENAI_MODEL_TTS=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Opsi parameter eksplisit (tidak ada fallback otomatis). Bawaan sudah sesuai dokumentasi.
# OPENAI_STT_LANG_FIELD=languages        # languages (gpt-transcribe) atau language (model lama)
# OPENAI_INSTRUCTION_ROLE=developer      # developer atau system
# OPENAI_TRANSLATE_REASONING=none        # kosongkan untuk tidak mengirim reasoning_effort
# OPENAI_CLIENT_REQUEST_ID=true          # kirim X-Client-Request-Id = ID transaksi (untuk rekonsiliasi)
# OPENAI_SAFETY_ID=true                  # kirim safety_identifier (hash id kode, bukan data pribadi)

# --- Penjaga satu instance (jangan dimatikan di hosting) ---
# Proses kedua pada DATA_DIR yang sama menolak start. Setelah crash/SIGKILL, restart menunggu paling lama LOCK_STALE_MS.
# DATA_LOCK=true
# LOCK_STALE_MS=15000
# LOCK_WAIT_MS=30000

# --- Penyimpanan ---
# Di hosting arahkan ke Volume permanen (mis. /data) agar saldo kredit tidak hilang saat restart.
DATA_DIR=./data

# --- Biaya kredit per panggilan (sesuaikan dengan harga jual) ---
COST_STT=2
COST_TRANSLATE=1
COST_TTS_PER_100=1
